#include <SPI.h>
#include <MFRC522.h>
#include <WiFi.h>
#include <HTTPClient.h>

// --- CONFIGURACIÓN DE RED [!] ---
const char* ssid = "TU_WIFI";          // [!] MARCAR CLARAMENTE: Tu SSID
const char* password = "TU_PASSWORD";  // [!] MARCAR CLARAMENTE: Tu Password

// --- CONFIGURACIÓN SERVIDOR [!] ---
// Usaremos el archivo registrar.php que procesa el formulario y el UID
const char* serverName = "http://192.168.1.50/registrar.php"; // [!] MARCAR CLARAMENTE: IP de tu servidor

// --- PINES RFID RC522 ---
#define SS_PIN  5
#define RST_PIN 22
MFRC522 rfid(SS_PIN, RST_PIN);

void setup() {
  Serial.begin(115200);
  SPI.begin();           // Inicia el bus SPI[cite: 1]
  rfid.PCD_Init();       // Inicia el sensor RFID[cite: 1]
  
  pinMode(2, OUTPUT);    // LED azul del ESP32 para confirmar lectura

  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n¡Conectado con éxito!");
}

void loop() {
  // Verifica si hay una tarjeta presente
  if (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial())
    return;

  // Convertir el UID de bytes a String Hexadecimal
  String uidString = "";
  for (byte i = 0; i < rfid.uid.size; i++) {
    uidString += String(rfid.uid.uidByte[i] < 0x10 ? "0" : "");
    uidString += String(rfid.uid.uidByte[i], HEX);
  }
  uidString.toUpperCase();
  
  Serial.print("Tarjeta detectada. UID: ");
  Serial.println(uidString);

  // Enviar el UID al servidor PHP
  enviarUID(uidString);

  // Pausa para evitar lecturas duplicadas infinitas
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
  delay(2000); 
}

void enviarUID(String uid) {
  if(WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    
    // Configuramos el destino
    http.begin(serverName); 
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");

    // Preparamos el dato POST[cite: 1, 2]
    String httpRequestData = "uid=" + uid;
    
    Serial.println("Enviando UID al servidor...");
    int httpResponseCode = http.POST(httpRequestData);

    if (httpResponseCode > 0) {
      String response = http.getString();
      Serial.println("Código HTTP: " + String(httpResponseCode));
      Serial.println("Respuesta: " + response);
      
      // Feedback visual (parpadeo de LED)
      digitalWrite(2, HIGH);
      delay(500);
      digitalWrite(2, LOW);
    } else {
      Serial.print("Error enviando POST: ");
      Serial.println(httpResponseCode);
    }
    
    http.end();
  } else {
    Serial.println("WiFi desconectado");
  }
}